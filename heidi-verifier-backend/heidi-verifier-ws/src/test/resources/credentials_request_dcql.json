{
  "nonce": "1234",
  "client_id": "https://verifier.example",
  "presentation_profile_id": "EUDI_PRESENTATION_2026_1",
  "signing_identity": "verifier-identity",
  "redirect_uri": "https://verifier.example/redirect",
  "name": "Credential request using DCQL",
  "purpose": "To verify the disclosure of all attributes",
  "dcql_query": {
    "credentials": [
      {
        "id": "pid",
        "format": "vc+sd-jwt",
        "claims": [
          {
            "path": [
              "family_name"
            ]
          },
          {
            "path": [
              "given_name"
            ]
          }
        ]
      },
      {
        "id": "pid-w3c",
        "format": "vc+sd-jwt",
        "claims": [
          {
            "path": [
              "credentialSubject",
              "family_name"
            ]
          },
          {
            "path": [
              "credentialSubject",
              "given_name"
            ]
          }
        ]
      },
      {
        "id": "pid-open-badges",
        "format": "ldp_vc",
        "claims": [
          {
            "path": [
              "credentialSubject",
              "achievement"
            ]
          }
        ],
        "meta": {
          "type_values": [
            [
              "VerifiableCredential",
              "OpenBadgeCredential"
            ]
          ]
        }
      }
    ],
    "credential_sets": [
      {
        "options": [
          [
            "pid"
          ],
          [
            "pid-w3c"
          ],
          [
            "pid-open-badges"
          ]
        ]
      }
    ]
  }
}
