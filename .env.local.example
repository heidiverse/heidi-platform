# Host reachable by the wallet used for local testing. Keep the scheme and omit
# the port; Caddy terminates HTTPS on HEIDI_HTTPS_PORT. Use a LAN name or IP
# rather than localhost for a phone.
HEIDI_PUBLIC_HOST=https://localhost
HEIDI_HTTPS_PORT=8443
HEIDI_CA_PORT=80

# Caddy is the only public HTTPS endpoint. Spring and Vite stay HTTP on their
# upstream ports. Caddy generates its ignored local CA and certificates.
# Vite's dev-local mode reads this file too. Its API URL follows the host and
# HTTPS port above; set VITE_HEIDI_API_BASE_URL only to override that URL.
VITE_HEIDI_DEFAULT_NAMESPACE=org.iso.18013.5.1
VITE_HEIDI_DEFAULT_DOCTYPE=org.iso.18013.5.1.mDL
VITE_APP_VERSION=local
# VITE_HEIDI_API_BASE_URL=https://localhost:8443/

# Local development database identities and passwords; do not reuse in deployments.
PLATFORM_POSTGRES_DB=heidi_platform_api
PLATFORM_POSTGRES_USER=heidi_platform_api
PLATFORM_POSTGRES_PASSWORD=heidi_platform_api
PLATFORM_POSTGRES_PORT=5432

ISSUER_POSTGRES_DB=heidi_issuer
ISSUER_POSTGRES_USER=heidi_issuer
ISSUER_POSTGRES_PASSWORD=heidi_issuer

VERIFIER_POSTGRES_DB=heidi_verifier
VERIFIER_POSTGRES_USER=heidi_verifier
VERIFIER_POSTGRES_PASSWORD=heidi_verifier

# Signing uses the platform's Postgres container with its own database and role.
SIGNING_POSTGRES_DB=heidi_signing
SIGNING_POSTGRES_USER=heidi_signing
SIGNING_POSTGRES_PASSWORD=heidi_signing

# A second checkout of this repository can run its own stack next to the first
# one: give it its own ports here. `just` exports these to compose and to the
# services, and the `local` Spring profile imports this file, so one setting
# moves a container, the service that connects to it, and the URLs the other
# services use to reach it. Container names come from the checkout's directory
# name, so two directories never collide.
# HEIDI_PLATFORM_PORT=8090
# HEIDI_ISSUER_PORT=8092
# HEIDI_VERIFIER_PORT=8093
# HEIDI_PLATFORM_MANAGEMENT_PORT=8091
# HEIDI_ISSUER_MANAGEMENT_PORT=8094
# HEIDI_VERIFIER_MANAGEMENT_PORT=8095
# HEIDI_SIGNING_PORT=8096
# HEIDI_WEB_PORT=5183
# HEIDI_CA_PORT=8087
#
# Local signing keys are persisted in the dedicated signing database. `just`
# generates the encryption key in the ignored .env.local on first run and
# preserves it across restarts. Deployments must provide their own stable secret.
HEIDI_SIGNING_SOFTWARE_DATABASE_ENABLED=true

# Optional while local authentication is `none`; required when using registered-key auth.
# HEIDI_PLATFORM_SIGNING_PROVIDER_CLIENT_SEED=
# HEIDI_ISSUER_SIGNING_PROVIDER_CLIENT_SEED=
# HEIDI_VERIFIER_SIGNING_PROVIDER_CLIENT_SEED=

# Optional issuer overrides. Defaults are defined in application.properties.
# HEIDI_ISSUER_ENFORCEMENT_DPOP=REQUIRED
# HEIDI_ISSUER_ENFORCEMENT_STATUS_LIST=OPTIONAL
# HEIDI_ISSUER_ENFORCEMENT_TX_CODE=OPTIONAL
# HEIDI_ISSUER_ENFORCEMENT_CLIENT_ATTESTATION=OPTIONAL
HEIDI_ISSUER_ACCESS_TOKEN_LIFETIME_SECONDS=600
HEIDI_ISSUER_REFRESH_TOKEN_LIFETIME_SECONDS=2592000
HEIDI_ISSUER_DPOP_PROOF_MAX_AGE_SECONDS=300
HEIDI_ISSUER_DPOP_NONCE_LIFETIME_SECONDS=300

# Platform defaults for new tenants and signing-provider capability refresh.
HEIDI_PLATFORM_LOCALIZATION_DEFAULT_LANGUAGE=en
HEIDI_PLATFORM_SIGNING_PROVIDER_CAPABILITY_REFRESH_INTERVAL_MS=21600000
HEIDI_PLATFORM_SIGNING_PROVIDER_CAPABILITY_REFRESH_INITIAL_DELAY_MS=60000
