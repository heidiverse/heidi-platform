{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Heidi Integrator API",
    "description" : "Run issuance and presentation processes.\n\n## Start here\n\n1. Your backend calls `POST /integration/v1/processes`.\n2. Your backend calls `POST /integration/v1/processes/{processId}/start`.\n3. Give only the returned `clientInteractionToken` to the browser.\n4. Use Heidi Web Components, or call `GET /interaction/v1/processes/current`.\n5. Your backend polls `GET /integration/v1/processes/{processId}/result`.\n\n`/integration/v1` is primarily backend-to-backend. `/interaction/v1` is browser-facing. Sections marked **Optional** support custom clients and are not required for the standard flow.",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "Start here: backend process lifecycle",
    "description" : "Backend-only calls for initializing, starting, and retrieving issuance or presentation processes. Never expose the API key or process token to a browser."
  }, {
    "name" : "Then: browser process interaction",
    "description" : "Browser-safe continuation of a process already started by the integrating backend. Heidi Web Components call this automatically; a custom frontend calls it with the short-lived client interaction token."
  }, {
    "name" : "Discover integration capabilities",
    "description" : "Lets an integrating backend inspect which credential schemas and scopes its API key may use before starting a process."
  }, {
    "name" : "Presentation wallet hand-off",
    "description" : "Browser endpoint that turns a presentation hand-off token into the redirect to the user's wallet. Web Components navigate here automatically."
  }, {
    "name" : "Optional: presentation status and metadata",
    "description" : "Browser helpers for custom presentation pages. Standard Web Components handle these calls internally."
  } ],
  "paths" : {
    "/integration/v1/processes" : {
      "post" : {
        "tags" : [ "Start here: backend process lifecycle" ],
        "summary" : "Initialize an integration process",
        "description" : "Creates an issuance or presentation process. Returns `processId` and a backend-only `processToken`. Retain both on the integrating server, then exchange the token through the start endpoint. The token must never reach a browser.",
        "operationId" : "initialize",
        "parameters" : [ {
          "name" : "Authorization",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-API-KEY",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/InitializeProcessRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IntegrationProcessInitializationResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "apiKeyAuthorization" : [ ]
        }, {
          "apiKeyHeader" : [ ]
        } ]
      }
    },
    "/integration/v1/processes/{processId}/start" : {
      "post" : {
        "tags" : [ "Start here: backend process lifecycle" ],
        "summary" : "Start an initialized integration process",
        "description" : "Exchanges the backend-only process token and starts the issuer or verifier transaction. The response contains a short-lived `clientInteractionToken`; send only that token to the browser or Web Component.",
        "operationId" : "start",
        "parameters" : [ {
          "name" : "processId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "Authorization",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-API-KEY",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StartIntegrationProcessRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IntegrationProcessResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "apiKeyAuthorization" : [ ]
        }, {
          "apiKeyHeader" : [ ]
        } ]
      }
    },
    "/interaction/v1/transactions/{transactionId}/status" : {
      "get" : {
        "tags" : [ "Optional: presentation status and metadata" ],
        "summary" : "Read public presentation transaction status",
        "description" : "Lets a browser ticket page poll a presentation transaction after it has a transaction ID. It returns lifecycle status only; disclosed claims remain available exclusively from the backend process result endpoint.",
        "operationId" : "getStatus",
        "parameters" : [ {
          "name" : "transactionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConnectionStateV2"
                }
              }
            }
          }
        }
      }
    },
    "/interaction/v1/qr/openid4vp" : {
      "get" : {
        "tags" : [ "Presentation wallet hand-off" ],
        "summary" : "Redirect the browser to a presentation wallet",
        "description" : "Consumes the one-time `authFlowToken` from Heidi's presentation hand-off URL, creates the OpenID4VP authorization request, and responds with a `303` redirect to the wallet. Integrators normally use the hand-off URL returned by the browser interaction endpoint instead of constructing this request themselves.",
        "operationId" : "initiateOpenId4vpFlow",
        "parameters" : [ {
          "name" : "authFlowToken",
          "in" : "query",
          "description" : "One-time presentation hand-off token. Treat it as a short-lived browser capability and do not log it.",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "useDcApi",
          "in" : "query",
          "description" : "Use the browser Digital Credentials API instead of a wallet URI redirect when supported.",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        }, {
          "name" : "OID4VPVersion",
          "in" : "query",
          "description" : "OID4VP protocol version expected by the target wallet. Keep the default unless the deployment profile requires another version.",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "DRAFT_28",
            "enum" : [ "DRAFT_21", "DRAFT_24", "DRAFT_26", "DRAFT_28", "VERSION_ONE_DOT_ZERO" ]
          },
          "example" : "DRAFT_28"
        } ],
        "responses" : {
          "303" : {
            "description" : "Redirect to the wallet authorization request",
            "headers" : {
              "Location" : {
                "description" : "Wallet authorization request URI",
                "style" : "simple",
                "schema" : {
                  "type" : "string",
                  "format" : "uri"
                }
              }
            }
          }
        }
      }
    },
    "/interaction/v1/processes/current" : {
      "get" : {
        "tags" : [ "Then: browser process interaction" ],
        "summary" : "Get browser-safe interaction data",
        "description" : "Call after the backend start endpoint returns `clientInteractionToken`. The response contains current process state, wallet hand-off data, resolved client configuration, and allowlisted display claims. It never returns the integration API key, process token, or complete backend result.",
        "operationId" : "get",
        "parameters" : [ {
          "name" : "Authorization",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClientInteractionResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "clientInteractionToken" : [ ]
        } ]
      }
    },
    "/interaction/v1/presentation/dcqlQuery/{schemaId}" : {
      "get" : {
        "tags" : [ "Optional: presentation status and metadata" ],
        "summary" : "Build the DCQL request for a proof schema",
        "description" : "Advanced helper for a custom presentation UI that needs the exact claims requested by a published proof schema. The standard process flow and Heidi Web Components resolve this automatically.",
        "operationId" : "getDcqlQuery",
        "parameters" : [ {
          "name" : "schemaId",
          "in" : "path",
          "description" : "UUID of the published proof schema.",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DcqlQuery"
                }
              }
            }
          }
        }
      }
    },
    "/integration/v1/processes/{processId}/result" : {
      "get" : {
        "tags" : [ "Start here: backend process lifecycle" ],
        "summary" : "Get the complete integration process result",
        "description" : "Poll from the integrating backend using the original API key. Returns process state and disclosed claims. Raw VP data is returned only when `includeVpToken` was requested during initialization.",
        "operationId" : "result",
        "parameters" : [ {
          "name" : "processId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "Authorization",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-API-KEY",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IntegrationProcessResult"
                }
              }
            }
          }
        },
        "security" : [ {
          "apiKeyAuthorization" : [ ]
        }, {
          "apiKeyHeader" : [ ]
        } ]
      }
    },
    "/integration/v1/credentials" : {
      "get" : {
        "tags" : [ "Discover integration capabilities" ],
        "summary" : "List credential schemas allowed for an API key",
        "description" : "Returns the organisation, scopes, and published credential schemas assigned to the supplied `X-API-KEY`. Use these identifiers when building an issuance initialization request. This endpoint accepts only the `X-API-KEY` header form.",
        "operationId" : "get_1",
        "parameters" : [ {
          "name" : "X-API-KEY",
          "in" : "header",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
